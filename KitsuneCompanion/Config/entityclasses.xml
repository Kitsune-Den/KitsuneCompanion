<?xml version="1.0" encoding="UTF-8" ?>
<configs>

    <append xpath="/entity_classes">

        <entity_class name="kitsuneCompanion" extends="animalCoyote">

            <property name="Tags" value="entity,animal,companion,fox,kitsune" />
            <property name="UserSpawnType" value="Menu" />
            <property name="IsEnemyEntity" value="false" />

            <!-- Step 9 Phase 2: keep inherited EntityEnemyAnimal (from
                 animalCoyote → animalWolf) class but apply the Oak Pets
                 supporting properties: RootMotion entity-property, explicit
                 ModelType, AvatarController, and prefab metadata. The Stag
                 class override was capping world velocity to deer-pace.
                 The wolf class allows higher speeds at the cost of a more
                 hostile default behavior tree (we override AI tasks
                 elsewhere to neutralize). -->
            <property name="Prefab" value="#@modfolder:Resources/Bundles/Kitsune.unity3d?Fox" />
            <property name="PrefabCombined" value="true" />
            <property name="ModelType" value="Standard" />
            <property name="AvatarController" value="AvatarAnimalController" />
            <property name="RootMotion" value="true" />
            <property name="HasDeathAnim" value="true" />
            <property name="HasRagdoll" value="true" />

            <property name="MapIcon" value="" />
            <property name="TrackerIcon" value="" />
            <property name="CompassIcon" value="" />
            <property name="CompassUpIcon" value="" />
            <property name="CompassDownIcon" value="" />
            <property name="NavObject" value="" />

            <property name="Mass" value="60" />
            <property name="Weight" value="60" />
            <!-- SizeScale tuned by visual iteration on the Red Fox prefab.
                 0.75 = chibi (ankle-high). 2.5 = direfox (wolf-size, head
                 at player's belly). 1.5 lands at "small dog / large fox"
                 — reads as a real fox with companion presence. Adjust by eye. -->
            <property name="SizeScale" value="1.5" />

            <!-- Move speeds bumped for the custom-mesh kitsune. Original
                 0.55/1.35 was creeping pace; these values match a slightly
                 faster-than-coyote feel since a fox companion should keep
                 up with the player on a brisk walk. Tune by feel. -->
            <!-- Sane wolf-class speeds. Vanilla wolf is 1.42; player walk
                 is ~1.5 m/s so pet-pace at ~2 keeps up nicely without
                 outrunning. Iterate by feel. -->
            <property name="MoveSpeed" value="2.0" />
            <property name="MoveSpeedAggro" value="3.0" />
            <property name="MoveSpeedRun" value="2.5" />
            <property name="MoveSpeedPanic" value="3.5" />
            <property name="JumpStrength" value="2.4" />
            <property name="JumpMaxDistance" value="3" />

            <property name="ExperienceGain" value="0" />
            <property name="LootListOnDeath" value="" />

            <!-- Inherit AITask slots from animalCoyote / animalWolf except the
                 AttackTarget filter (remove EntityPlayer from chase list). -->
            <property name="AITask-4" value="ApproachAndAttackTarget" data="class=EntityZombie,20,EntityBandit,15" />
            <property name="AITarget-3" value="SetNearestEntityAsTarget" data="class=EntityZombie,0,-8,EntityBandit,0,-8" />

            <!-- Use SCore's Utility AI for follow behavior. The vanilla EAI
                 system has no follow task and direct movement APIs bypass
                 the animator (visible as "fox slide"). SCore's FollowSDX
                 task implements proper animator-aware pathfinding via
                 PathFinderThread. Activates when CompanionTicker sets the
                 Leader cvar (player entityId) + CurrentOrder cvar (1=Follow)
                 on the kitsune each fast tick. Requires 0-SCore mod. -->
            <property name="AIPackages" value="KitsuneCompanionAI" />

            <!-- Mute idle ambient barks (SoundRandom) — they're the annoying
                 part. Event-triggered sounds (alert, attack, hurt, death,
                 sense, giveup) inherit normally; those fire on real beats
                 and are useful audio cues. -->
            <property name="SoundRandom" value="" />

            <effect_group name="Base Effects">
                <passive_effect name="HealthMax" operation="base_set" value="120" />
                <!-- WalkSpeed/RunSpeed passive_effects ARE the runtime
                     speed source for NPC-style entities (verified via
                     LittleRedSonja Punisher NPC reference, Nexus 8373,
                     which uses passive_effect RunSpeed=1.1 for its
                     actual movement). Earlier we set them too low (1.2/
                     2.0) and observed slowness; we then removed them
                     thinking they were throttling, which made things
                     worse. Setting them HIGH this time. Tune by feel. -->
                <passive_effect name="WalkSpeed" operation="base_set" value="4.0" />
                <passive_effect name="RunSpeed"  operation="base_set" value="6.0" />
            </effect_group>

        </entity_class>

    </append>

    <!-- Grant the Foxfire Pouch (starter Tail-Space buff, +18 BagSize) to
         every player automatically on spawn. The buff is hidden and
         permanent, so this fires once on the first onSelfBuffUpdate tick
         after spawn and stays applied for the character's life. Higher
         tiers (Satchel/Den-Bag/Tail-Space) are gated behind future quest
         rewards and are NOT applied here.

         Note: playerFemale extends playerMale in vanilla, so the trigger
         propagates to both via inheritance. -->
    <append xpath="/entity_classes/entity_class[@name='playerMale']">
        <effect_group name="Foxfire Tail-Space (starter)">
            <triggered_effect trigger="onSelfBuffUpdate"
                              action="AddBuff"
                              buff="buffKitsuneFoxfirePouch"
                              target="self">
                <requirement name="!HasBuff" buff="buffKitsuneFoxfirePouch"/>
            </triggered_effect>
        </effect_group>
    </append>

</configs>
